# World metadata. Changing this file needs a server restart.
module(
    # The script API version every package here targets.
    api_version = 1,

    # Minutes between routine checkpoints. A graceful shutdown or reload always saves, so a
    # longer interval only matters if the server crashes. Defaults to 30.
    checkpoint_minutes = 30,

    # The numbers every character and mob is measured by. The engine names none of them: the
    # rules (rules/combat.star) give them meaning. Each is a name, or stat(name, label = ...) to
    # set the label players see; the default label is the name capitalized. Order is display
    # order in `score` and the web client. Changing a name later needs a server wipe
    # (gups serve --wipe), because saved characters are keyed by these names.
    stats = [
        stat("str", label = "Strength"),
        stat("dex", label = "Dexterity"),
        stat("con", label = "Constitution"),
        stat("int", label = "Intelligence"),
        stat("wis", label = "Wisdom"),
        stat("cha", label = "Charisma"),
        stat("speed", label = "Speed"),
        "armor",
    ],

    # The values that rise and fall in play: damage lowers them, healing and regeneration raise
    # them, and skill costs and movement spend them. Which of them incapacitates or kills is
    # decided by `condition` in the rules. vital(name, label = ...) works like stat().
    vitals = [
        vital("hp", label = "Hit points"),
        "mana",
        vital("move", label = "Movement"),
    ],

    # The kinds of damage. A weapon's damage_type, damage(...) effects, resists(...) and
    # `mitigate` in the rules all use these names (DAMAGE.fire in scripts).
    damage_types = ["bludgeon", "slash", "pierce", "fire"],

    # The damage type of an unarmed auto-attack, and of a weapon that names none. One of
    # damage_types.
    unarmed_damage_type = "bludgeon",

    # Perception channels beyond the built-in sight and sound. Exits and doors can block
    # them and skills can list them; the engine raises no events on them itself.
    channels = ["spell"],

    # How many pulses a mob remembers what it experienced and witnessed in combat (who attacked
    # it, who healed or cast, who walked in). rules/targeting.star reads these memories. Defaults
    # to 0, which keeps none; a mob's own memory_pulses overrides it. 1200 pulses is 5 minutes.
    memory_pulses = 1200,

    # The telnet prompt. {hp} is a vital's current value and {max_hp} its maximum. Without
    # this line the prompt lists every vital: <20hp 20mana 100move> .
    prompt = "<{hp}hp {mana}m {move}mv> ",

    # The engine features this world uses; leaving the line out turns all four on. track needs
    # combat. A feature that is off doesn't exist for the world: its commands, declarations,
    # hooks and messages are refused or left out. Fixed per database: changing the list needs a
    # server wipe (gups serve --wipe).
    # features = ["combat", "track", "skills", "leveling"],

    # New names for engine commands, e.g. a world with no magic that calls casting "invoke".
    # Aliases and prefixes below then name the new word, and the old one is free for your own
    # global_command. Needs only a restart.
    # rename = {"cast": "invoke"},

    # The room new characters start in. Without it they start at //zones/tutorial:gate, or
    # in the first room by label if there is no tutorial.
    # start_room = "//zones/tutorial:gate",

    # Shorter words for engine commands. Several aliases may name the same command; remove an
    # entry to drop that alias.
    aliases = {
        "l": "look",
        "i": "inventory",
        "inv": "inventory",
        "eq": "equipment",
        "k": "kill",
        "attack": "kill",
        "c": "cast",
        "take": "get",
        "unwield": "remove",
    },

    # Single characters that stand for a command at the start of a line: 'hello says hello.
    prefixes = {
        "'": "say",
        "\"": "say",
        "%": "cast",
    },
)
