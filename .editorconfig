root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_style = space
indent_size = 2
max_line_length = 120
ij_markdown_wrap_text_at_right_margin = true
ij_markdown_right_margin = 120
ij_markdown_force_one_space_after_list_bullet = true
ij_markdown_indent_inner_list_items = true
